+def _facebook_redirect_uri() -> str:
+    return (os.getenv("FB_LOGIN_REDIRECT_URI") or "http://localhost:5000/api/auth/oauth/facebook/callback").strip()
+
+
+def _facebook_login_scope() -> str:
+    raw_scope = (os.getenv("FB_LOGIN_SCOPE") or "").strip()
+    requested = {s.strip() for s in raw_scope.split(",") if s.strip()}
+    # These are always valid for Facebook Login; ensure at least one supported permission exists.
+    requested.update({"public_profile", "email"})
+    ordered = [s for s in ("public_profile", "email") if s in requested]
+    return ",".join(ordered)
+
