# Core
# DATABASE_URL: sqlite is enough for `python app.py` / pytest. The Docker
# Compose stack overrides this to point at the postgres service instead
# (see docker-compose.yml) -- the POSTGRES_* values below are what that
# override is built from, so they must still be set even though this line
# says sqlite.
DATABASE_URL=sqlite:///autosocial.db
REDIS_URL=redis://localhost:6379/0

# Local/CI-safe defaults: run jobs inline (no worker needed) and never call a
# real, billed AI/YouTube/Meta API. Production sets both of these to false.
SYNC_JOBS=true
USE_MOCK_PROVIDERS=true
MOCK_META=true
ENV=development

# Postgres (used by the Docker Compose stack only; native/local dev uses the
# sqlite DATABASE_URL above instead). These are local-only placeholder
# values -- change them for anything beyond a local throwaway stack.
POSTGRES_DB=autosocial_dev
POSTGRES_USER=autosocial_dev
POSTGRES_PASSWORD=change_this_local_password

# Admin seed (local/dev only -- production creates its own admin separately)
ADMIN_EMAIL=admin@autosocial.local
ADMIN_PASSWORD=admin12345

# OpenAI + Credit economics
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRICE_INPUT_PER_1M=0.15
OPENAI_PRICE_OUTPUT_PER_1M=0.60
CREDIT_MULTIPLIER=1
AVG_TOKENS_PER_POST=1200
SOFT_LIMIT_RATIO=0.9
OVERDRAFT_LIMIT=-10000

# Stripe (required for real billing)
# Configure in the production secret store. Never commit real credentials.
# SECURITY: earlier revisions of this file committed a real Stripe TEST secret
# key and webhook secret. They remain in Git history and MUST be revoked/
# rotated manually in the Stripe dashboard. Removing them here does NOT remove
# them from history.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO_V2=
STRIPE_PRICE_AGENCY_V2=
STRIPE_PRICE_LIGHT=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PACK_S_PRICE=
STRIPE_PACK_M_PRICE=
STRIPE_PACK_L_PRICE=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/?success=1
STRIPE_CANCEL_URL=http://localhost:3000/billing/?cancel=1
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing/

# Token encryption for social accounts (Fernet key). The value below is a
# throwaway key generated for this example file -- it protects nothing real
# and is fine for a local/mock stack, but generate your own for anything
# that will ever hold a real OAuth token:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=ok9ys4m7cMEoTmmc3knjS44DOxtFcNSAtmW79iaZ5vI=

# URLs / CORS / cookies
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
SHOW_SOCIAL_LOGIN=false

# Email verification / anti-bot auth
APP_NAME=AutoSocial GPT
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_COOLDOWN_SECONDS=45
AUTH_MAX_VERIFY_ATTEMPTS=5
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_MAX_PER_IP=25
AUTH_RATE_MAX_PER_EMAIL=8
AUTH_CODE_PEPPER=change_me_long_random_value

# Meta OAuth (publishing) -- optional. Leave blank to run without Meta/
# Facebook connect; nothing in the core video pipeline needs it.
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/integrations/meta/callback
# Backward compatibility alias (optional):
# REDIRECT_URI=http://localhost:5000/api/integrations/meta/callback
# If Meta requires HTTPS for redirect URIs, set a public HTTPS tunnel base (ngrok/cloudflared):
# PUBLIC_API_BASE_URL=https://abcd-1234.ngrok-free.app
PEXELS_API_KEY=
PIXABAY_API_KEY=
BASE_DIR=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_RENDER_CONCURRENCY=2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=eddy
VIDEO_BG_MUSIC_ENABLED=false
VIDEO_BG_MUSIC_PATH=
FB_OAUTH_SCOPE=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,business_management

# Login OAuth (Google/Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback
# Aliases supported: FACEBOOK_APP_ID/FACEBOOK_CLIENT_ID and FACEBOOK_APP_SECRET/FACEBOOK_CLIENT_SECRET
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FB_LOGIN_APP_ID=your_facebook_login_app_id
FB_LOGIN_APP_SECRET=
FB_LOGIN_REDIRECT_URI=http://localhost:5000/api/auth/oauth/facebook/callback
FB_LOGIN_SCOPE=email,public_profile

# Private single-admin mode (fail closed: empty allowlist denies all access).
# Set to the same address as ADMIN_EMAIL above so a fresh local/mock stack
# can actually log in without further edits.
PRIVATE_ADMIN_MODE=true
ADMIN_ALLOWLIST_EMAILS=admin@autosocial.local

# AI budgets and pricing (analytics stage)
AI_DAILY_BUDGET=5.0
AI_MONTHLY_BUDGET=50.0
AI_MAX_COST_PER_VIDEO=2.0
AI_MAX_REGENERATIONS_PER_PROJECT=10
AI_MAX_VIDEOS_PER_DAY=20
AI_CONFIRM_COST_THRESHOLD=1.0
# Optional pricing override, same JSON structure as ai_pricing.DEFAULT_PRICING
AI_PRICING_JSON=

# Footage segmentation, repeat protection and subtitles
FOOTAGE_SEGMENT_SECONDS=3.0
FOOTAGE_SEGMENT_MIN_SECONDS=2.5
FOOTAGE_SEGMENT_MAX_SECONDS=3.5
FOOTAGE_SAME_CHANNEL_COOLDOWN_DAYS=30
FOOTAGE_GLOBAL_COOLDOWN_DAYS=7
FOOTAGE_ALLOW_REUSE_FALLBACK=true
FOOTAGE_REUSE_ONLY_AFTER_EXHAUSTED_SEARCH=true
PEXELS_MAX_SEARCH_QUERIES_PER_SEGMENT=4
PEXELS_MAX_PAGES_PER_QUERY=2
PEXELS_CANDIDATES_PER_SEGMENT=12
SUBTITLE_MAX_LINE_CHARS=36
SUBTITLE_MARGIN_BOTTOM_PX=380
SUBTITLE_FONT_NAME=Arial
SUBTITLE_HIGHLIGHT_KEYWORD=false
VIDEO_CLIP_FADE_SECONDS=0.2

# Topic generator + visual AI validation
TOPIC_COOLDOWN_DAYS=60
TOPIC_DUPLICATE_THRESHOLD=0.6
TOPIC_MAX_GENERATION_ATTEMPTS=3
VISUAL_VALIDATION_ENABLED=false
VISUAL_VALIDATION_FAIL_OPEN=true
VISUAL_RELEVANCE_MIN_SCORE=0.55
VISUAL_SUBJECT_MIN_SCORE=0.4
VISUAL_ACTION_MIN_SCORE=0.3
VISUAL_MAX_CANDIDATES_PER_SEGMENT=5
VISUAL_FRAME_COUNT=5
VISUAL_AI_DAILY_BUDGET_USD=2.0
VISUAL_AI_MAX_CHECKS_PER_VIDEO=30
VISUAL_AI_MAX_CHECKS_PER_SEGMENT=3
VISUAL_AI_CACHE_TTL_DAYS=90
VISUAL_AI_MODEL=gpt-4o-mini
VISUAL_AI_PROVIDER=mock

# AI Content Director
DIRECTOR_ENABLED=true
DIRECTOR_USE_AI=true
DIRECTOR_CANDIDATES_PER_RUN=6
DIRECTOR_DUPLICATE_THRESHOLD=0.55
DIRECTOR_PILLAR_RECENCY_PENALTY=0.5
DIRECTOR_ANALYTICS_WEIGHT=0.3
